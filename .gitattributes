# Normalize line endings, keep web + cpp diff-friendly
* text=auto eol=lf

*.cpp text diff=cpp
*.hpp text diff=cpp
*.h text diff=cpp
*.cmake text
CMakeLists.txt text
Makefile text
*.html text
*.css text
*.js text
*.md text
*.json text

